# Copy to .env (or export) before `npm run dev`. Bridge reads process.env.

# Network (keep on localhost — the bridge has no auth)
AIPASS_PORT=8787
AIPASS_HOST=127.0.0.1
# AIPASS_ALLOWED_HOSTS=example.com  # extra Host values to accept (comma list)

# Defaults
AIPASS_MODEL=gemini-3.1-flash-lite
AIPASS_MODEL_FILTER=chat            # chat = only chat models; omit for all kinds
AIPASS_CONVERSATION_ID=            # pin a conversation id instead of "most recent"
AIPASS_ASSISTANT_ID=               # bind new conversations to a custom assistant
AIPASS_ASSISTANT_FIELD=aiAssistantId
AIPASS_ASPECT_RATIO=1:1
AIPASS_TOOL_VISIBILITY=reasoning    # reasoning | text | off

# Timeouts (ms)
AIPASS_IDLE_TIMEOUT_MS=180000
AIPASS_MEDIA_TIMEOUT_MS=900000
AIPASS_KEEPALIVE_MS=15000

# Opt-ins
# AIPASS_CORS_ORIGIN=https://example.com  # allow a browser page to call the bridge
# AIPASS_ADMIN=1                          # enable admin/deployment routes
# AIPASS_MODELS=gemini-3.1-flash-lite,claude-sonnet-5@default  # fallback model ids