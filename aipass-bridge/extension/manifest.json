{
  "manifest_version": 3,
  "name": "aipass bridge",
  "version": "0.2.0",
  "description": "Relays local OpenAI-compatible requests through an open de.aipass.net tab.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.aipass.net/*",
    "https://aipass.net/*",
    "https://storage.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aipass.net/*",
        "https://aipass.net/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.aipass.net/*",
        "https://aipass.net/*"
      ],
      "js": [
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "aipass bridge"
  }
}
