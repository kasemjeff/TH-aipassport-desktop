{
  "//": "Type-check only. Editors pick this up automatically for files with a `// @ts-check` pragma. To check from the CLI: `npm run typecheck` (runs `tsc -p aipass-bridge/jsconfig.json`). No build step, no runtime dependency, no output. checkJs stays false so un-annotated files are not checked; files opt in with `// @ts-check`.",
  "compilerOptions": {
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "harness/log-line.mjs",
    "harness/events.mjs",
    "harness/log-file.mjs",
    "harness/gitignore.mjs",
    "harness/argguard.mjs",
    "harness/lang.mjs",
    "harness/authtoken.mjs",
    "harness/waf.mjs",
    "harness/run/options.mjs",
    "harness/run/context.mjs",
    "harness/run/budgets.mjs",
    "harness/rpc/context.mjs",
    "bridge/log-scrub.mjs",
    "bridge/private-hosts.mjs",
    "bridge/attachment-types.mjs"
  ]
}
