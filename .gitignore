# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# browser profile data & session locks
chrome-data/
*.log
Singleton*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local API captures (contain live session cookies)
apipass*.md
aipass*.md
*.har

# media npm run chat saves into the cwd by default (any model output, by type)
/aipass-*.png
/aipass-*.jpg
/aipass-*.jpeg
/aipass-*.webp
/aipass-*.mp4
/aipass-*.webm
/aipass-*.mp3
/aipass-*.wav

