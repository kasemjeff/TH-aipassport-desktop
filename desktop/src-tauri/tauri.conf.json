{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aipass desktop",
  "version": "0.2.0",
  "identifier": "com.aipass.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:8790",
    "beforeDevCommand": "node main.mjs --detach --root ..",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' asset: customprotocol:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    },
    "trayIcon": {
      "id": "aipass-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "aipass desktop"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["../sidecar/node"],
    "resources": {
      "../../aipass-bridge/bin": "aipass-bridge/bin/",
      "../../aipass-bridge/bridge": "aipass-bridge/bridge/",
      "../../aipass-bridge/deploy": "aipass-bridge/deploy/",
      "../../aipass-bridge/extension": "aipass-bridge/extension/",
      "../../aipass-bridge/harness": "aipass-bridge/harness/",
      "../../aipass-bridge/.gitignore": "aipass-bridge/.gitignore",
      "../../aipass-bridge/README.md": "aipass-bridge/README.md",
      "../../aipass-bridge/agent.mjs": "aipass-bridge/agent.mjs",
      "../../aipass-bridge/assistant-prompt.mjs": "aipass-bridge/assistant-prompt.mjs",
      "../../aipass-bridge/chat.mjs": "aipass-bridge/chat.mjs",
      "../../aipass-bridge/difflib.mjs": "aipass-bridge/difflib.mjs",
      "../../aipass-bridge/doctor.mjs": "aipass-bridge/doctor.mjs",
      "../../aipass-bridge/handoff.html": "aipass-bridge/handoff.html",
      "../../aipass-bridge/install.ps1": "aipass-bridge/install.ps1",
      "../../aipass-bridge/install.sh": "aipass-bridge/install.sh",
      "../../aipass-bridge/jsconfig.json": "aipass-bridge/jsconfig.json",
      "../../aipass-bridge/list.mjs": "aipass-bridge/list.mjs",
      "../../aipass-bridge/setup-assistant.mjs": "aipass-bridge/setup-assistant.mjs",
      "../../aipass-bridge/stats.mjs": "aipass-bridge/stats.mjs",
      "../main.mjs": "main.mjs",
      "../ui": "ui/"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    },    "publisher": "aipass",
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "AiPASS bridge, chat and file agent in a window",
    "longDescription": "A desktop front end for the aipass bridge: chat with the AiPASS models from a window, and let the file agent edit a project you point it at — with sessions, per-file approval, plan mode, helpers and compaction."
  }
}
